# Copy to .env and edit. Keep the real .env out of version control.

# Required in HTTP mode: bearer token MCP clients must send. Unused with --stdio.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=

# SilverBullet base URL. Must expose /.fs.
SB_URL=http://127.0.0.1:8123

# Optional: sent as Authorization: Bearer ... to SilverBullet.
# Note: on recent SilverBullet builds this alone does not enable auth; see README.
SB_AUTH_TOKEN=

# Sent on upstream calls. Some CDNs block Python's default urllib signature
# with 403 / error code 1010; change this if yours answers that way.
SB_USER_AGENT=silverbullet-mcp/1.0

# Bind address and port of this server.
MCP_HOST=127.0.0.1
MCP_PORT=9339
